<script>
(function(){
var TK=null,stu=[],ix=0,loaded=false,st=null;
var CF=['ca1','ca2','ca3','ca4','ca5','ca6','ca7','ca8','ca9','ca10'];
var SK=[['conduct','Conduct',5],['handwriting','Handwriting',5],['creativity','Creativity',10]];
var EX=[['test1','Test 1',10],['test2','Test 2',10],['mid_term','Mid Term',20],['final_exam','Final Exam',30]];

function grd(t){if(t>=90)return'A+';if(t>=80)return'A';if(t>=70)return'B+';if(t>=60)return'B';if(t>=50)return'C';if(t>=40)return'D';return'F';}
function grdC(g){return{'A+':'bg-success','A':'bg-success','B+':'bg-primary','B':'bg-primary','C':'bg-warning','D':'bg-warning','F':'bg-danger'}[g]||'bg-secondary';}

function gp(url,d,cb){
    if(!TK)TK=document.querySelector('meta[name="csrf-token"]');
    d._token=TK.content;
    $.post(url,d,function(r){if(cb)cb(r);}).fail(function(){alert('Request failed.');});
}

function calc(m){
    var ca=0,ex=0,i;
    for(i=0;i<10;i++)ca+=(parseFloat(m['ca'+(i+1)])||0);
    ca+=(parseFloat(m.conduct)||0)+(parseFloat(m.handwriting)||0)+(parseFloat(m.creativity)||0);
    for(i=0;i<EX.length;i++)ex+=(parseFloat(m[EX[i][0]])||0);
    var cs=ca>0?Math.round((ca/70)*30*100)/100:0;
    var gt=Math.round((cs+ex)*100)/100;
    return{caRaw:ca,caScaled:cs,examRaw:ex,grandTotal:gt,grade:grd(gt)};
}

function ok(){return $('#meAY').val()&&$('#meTerm').val()&&$('#meCls').val()&&$('#meSec').val()&&$('#meSub').val();}
function chk(){$('#meLoad').prop('disabled',!ok());}

$('#meAY').on('change',function(){
    var id=$(this).val();
    $('#meTerm').html('<option value="">-- Select --</option>');
    chk();if(!id)return;
    gp('/admin/mark-entries/api/terms',{academic_year_id:id},function(d){
        var h='<option value="">-- Select Term --</option>';
        $.each(d,function(k,v){h+='<option value="'+v.id+'">'+v.name+'</option>';});
        $('#meTerm').html(h);
    });
});
$('#meCls').on('change',function(){
    var id=$(this).val();
    $('#meSec').html('<option value="">-- Select --</option>').prop('disabled',!id);
    $('#meSub').html('<option value="">-- Select --</option>').prop('disabled',true);
    chk();if(!id)return;
    gp('/admin/mark-entries/api/sections',{class_id:id},function(d){
        var h='<option value="">-- Select Section --</option>';
        $.each(d,function(k,v){h+='<option value="'+v.id+'">'+v.name+'</option>';});
        $('#meSec').html(h).prop('disabled',false);
    });
});
$('#meSec').on('change',function(){
    var c=$('#meCls').val(),s=$(this).val();
    $('#meSub').html('<option value="">-- Select --</option>').prop('disabled',!(c&&s));
    chk();if(!(c&&s))return;
    gp('/admin/mark-entries/api/subjects',{class_id:c,academic_year_id:$('#meAY').val(),section_id:s},function(d){
        var h='<option value="">-- Select Subject --</option>';
        $.each(d,function(k,v){h+='<option value="'+v.id+'">'+v.name+'</option>';});
        $('#meSub').html(h).prop('disabled',false);
    });
});
$('#meTerm,#meSub').on('change',chk);

$('#meLoad').on('click',function(){
    var d={class_id:$('#meCls').val(),section_id:$('#meSec').val(),subject_id:$('#meSub').val(),academic_year_id:$('#meAY').val(),term_id:$('#meTerm').val()};
    $('#meLoad').prop('disabled',true).text('Loading...');
    gp('/admin/mark-entries/api/students',d,function(data){
        if(!data.length){$('#meLoad').prop('disabled',false).html('<i class="bi bi-check-circle me-1"></i> Load');alert('No students found.');return;}
        stu=data;ix=0;loaded=true;
        $('#meEmpty').hide();$('#meFilter').hide();
        rCtx();rNav();rCard();
        $('#meLoad').prop('disabled',false).html('<i class="bi bi-check-circle me-1"></i> Load');
    });
});

function rCtx(){
    var ay=$('#meAY option:selected').text(),tm=$('#meTerm option:selected').text(),
        cl=$('#meCls option:selected').text(),sc=$('#meSec option:selected').text(),
        su=$('#meSub option:selected').text();
    $('#meCtx').html('<div class="me-ctx"><span class="bdg bg-light text-dark border">'+ay+'</span><span style="color:#d1d5db">/</span><span class="bdg bg-light text-dark border">'+tm+'</span><span style="color:#d1d5db">/</span><span class="bdg bg-light text-dark border">'+cl+' '+sc+'</span><span style="color:#d1d5db">/</span><span class="bdg bg-success bg-opacity-10 text-success">'+su+'</span></div>').show();
}

function rNav(){
    var h='<button id="mePrev" '+(ix===0?'disabled':'')+'><i class="bi bi-chevron-left"></i> Prev</button>';
    h+='<div class="text-center"><span style="font-size:12px;color:#9ca3af;font-weight:500">Student '+(ix+1)+' of '+stu.length+'</span><div class="me-dots mt-1">';
    for(var i=0;i<stu.length;i++){h+='<span class="'+(i===ix?'on':i<ix?'dn':'')+'" data-i="'+i+'"></span>';}
    h+='</div></div><button id="meNext" '+(ix===stu.length-1?'disabled':'')+'>Next <i class="bi bi-chevron-right"></i></button>';
    $('#meNav').html(h).show();
    $('#mePrev').on('click',function(){if(ix>0){ix--;rCard();rNav();}});
    $('#meNext').on('click',function(){if(ix<stu.length-1){ix++;rCard();rNav();}});
    $('#meNav .me-dots span').on('click',function(){ix=parseInt($(this).data('i'));rCard();rNav();});
}

function rCard(){
    var s=stu[ix],m=s.marks||{},t=calc(m),gc=grdC(t.grade),h='';
    h+='<div class="me-hd"><div><h2>'+s.name+'</h2><small>'+(s.admission_number||'')+'</small></div>';
    if(t.grandTotal>0){h+='<div style="text-align:right"><span class="me-gd '+gc+'">'+t.grade+'</span><div style="color:rgba(255,255,255,.8);font-size:12px;margin-top:2px">'+t.grandTotal+' / 100</div></div>';}
    h+='</div>';
    h+='<div class="me-tb"><div><label>CA Raw / 70</label><div class="v" style="color:#0891b2">'+(t.caRaw>0?t.caRaw:'-')+'</div></div><div><label>CA Scaled / 30</label><div class="v" style="color:#0e7490">'+(t.caScaled>0?t.caScaled:'-')+'</div></div><div><label>Exam / 70</label><div class="v" style="color:#059669">'+(t.examRaw>0?t.examRaw:'-')+'</div></div></div>';
    h+='<div class="me-bd">';
    h+='<div class="me-sec"><div class="me-st"><i style="background:#0891b2"></i>Continuous Assessment <small style="color:#d1d5db;font-weight:400">(each /5)</small></div><div class="me-g5">';
    for(var i=1;i<=10;i++){var f='ca'+i,v=m[f];h+='<div class="me-fi ca"><label>CA '+i+'</label><input type="number" min="0" max="5" step="0.5" data-f="'+f+'" value="'+(v!=null?v:'')+'" placeholder="-"></div>';}
    h+='</div></div>';
    h+='<div class="me-sec"><div class="me-st"><i style="background:#d97706"></i>Skills</div><div class="me-g3">';
    for(var j=0;j<SK.length;j++){var f=SK[j][0],lb=SK[j][1],mx=SK[j][2],v=m[f];h+='<div class="me-fi sk"><label>'+lb+' /'+mx+'</label><input type="number" min="0" max="'+mx+'" step="0.5" data-f="'+f+'" value="'+(v!=null?v:'')+'" placeholder="-"></div>';}
    h+='</div></div>';
    h+='<div class="me-sec"><div class="me-st"><i style="background:#059669"></i>Examinations</div><div class="me-g4">';
    for(var j=0;j<EX.length;j++){var f=EX[j][0],lb=EX[j][1],mx=EX[j][2],v=m[f];h+='<div class="me-fi ex"><label>'+lb+' /'+mx+'</label><input type="number" min="0" max="'+mx+'" step="0.5" data-f="'+f+'" value="'+(v!=null?v:'')+'" placeholder="-"></div>';}
    h+='</div></div>';
    h+='</div>';
    h+='<div class="me-ft"><div id="meSave" class="me-sv"></div><a href="#" id="meBack" style="font-size:12px;color:#9ca3af;text-decoration:none"><i class="bi bi-x-circle me-1"></i>Change Filters</a></div>';
    $('#meCard').html(h).show();
    $('#meCard input').on('blur',onBlur);
    $('#meBack').on('click',function(e){e.preventDefault();loaded=false;stu=[];ix=0;$('#meCard,#meNav,#meCtx').hide();$('#meEmpty').show();$('#meFilter').show();});
}

function onBlur(){
    var $inp=$(this),f=$inp.data('f'),v=$inp.val()||0;
    stu[ix].marks[f]=parseFloat(v)||0;
    var t=calc(stu[ix].marks);
    $('#meSave').text('Saving...').css('color','#3b82f6');
    clearTimeout(st);
    st=setTimeout(function(){
        gp('/admin/mark-entries/api/save',{
            student_id:stu[ix].id,subject_id:$('#meSub').val(),
            academic_year_id:$('#meAY').val(),term_id:$('#meTerm').val(),
            class_id:$('#meCls').val(),section_id:$('#meSec').val(),
            mark_key:f,mark_value:v
        },function(){
            $('#meSave').html('<i class="bi bi-check-circle-fill me-1"></i>Saved').css('color','#059669');
            setTimeout(function(){$('#meSave').text('');},1500);
        });
    },600);
}

$(document).on('keydown',function(e){
    if(!loaded)return;
    if($(document.activeElement).is('input'))return;
    if(e.key==='ArrowLeft'&&ix>0){ix--;rCard();rNav();}
    if(e.key==='ArrowRight'&&ix<stu.length-1){ix++;rCard();rNav();}
});

var tx=0;
$(document).on('touchstart','#meCard',function(e){tx=e.originalEvent.changedTouches[0].screenX;});
$(document).on('touchend','#meCard',function(e){
    var dx=tx-e.originalEvent.changedTouches[0].screenX;
    if(Math.abs(dx)>60){
        if(dx>0&&ix>0){ix--;rCard();rNav();}
        if(dx<0&&ix<stu.length-1){ix++;rCard();rNav();}
    }
});
})();
</script>
