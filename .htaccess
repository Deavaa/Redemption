# ──────────────────────────────────────────────────────────────
# LARAVEL — REMOVE /public FROM URL (Root .htaccess)
# ──────────────────────────────────────────────────────────────
# Place this file in the PROJECT ROOT (same level as artisan, .env).
# On XAMPP, this is inside htdocs/Redemption/.
# On cPanel, this is inside public_html/ or a subdirectory.
#
# Static files (CSS, JS, images) are served from the public/
# directory. Dynamic routes go through root index.php.
# ──────────────────────────────────────────────────────────────

Options +FollowSymLinks +SymLinksIfOwnerMatch
DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── Block direct access to sensitive directories ──
    RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|storage|tests|vendor|deploy|node_modules)(/|$) - [F,L,NC]

    # ── Block direct access to sensitive files ──
    RewriteRule ^(artisan|composer\.(json|lock)|package\.json|package-lock\.json|phpunit\.xml|vite\.config\.js|webpack\.mix\.js|\.env\.example|info\.php)(/|$) - [F,L,NC]

    # ── Handle Authorization Header ──
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ── Serve static files from public/ directory ──
    # When browser requests /Redemption/css/admin.css, Apache maps this to
    # htdocs/Redemption/css/admin.css (which doesn't exist). We need to
    # serve it from htdocs/Redemption/public/css/admin.css instead.
    #
    # %{REQUEST_FILENAME} = full filesystem path Apache resolved
    #   e.g., C:/xampp/htdocs/Redemption/css/admin.css
    # We construct the public/ version and check if it exists.
    #
    # Step 1: Extract the directory part of REQUEST_FILENAME
    #   C:/xampp/htdocs/Redemption/css → C:/xampp/htdocs/Redemption
    # Step 2: Append /public + the URL path part ($1)
    #   C:/xampp/htdocs/Redemption/public/css/admin.css
    # Step 3: If that file exists, rewrite to serve it
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*?)$ public/$1 [L]

    # ── Route remaining requests to root index.php ──
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php [L]
</IfModule>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_value session.gc_maxlifetime 28800
    php_value session.gc_probability 0
    php_value session.gc_divisor 1
    php_value session.cookie_lifetime 28800
</IfModule>
