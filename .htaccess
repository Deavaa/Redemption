# ──────────────────────────────────────────────────────────────
# LARAVEL — REMOVE /public FROM URL (Root .htaccess)
# ──────────────────────────────────────────────────────────────
# Place this file in the PROJECT ROOT (same level as artisan, .env).
# On XAMPP, this is inside htdocs/Redemption/.
#
# This file does TWO things:
# 1. Routes all web traffic to root index.php (so /public is NOT in the URL)
# 2. Serves static files (CSS, JS, images) from the public/ directory
#
# CRITICAL: We route to ROOT index.php (NOT public/index.php).
# Root index.php fixes SCRIPT_NAME before delegating to public/index.php.
# ──────────────────────────────────────────────────────────────

# ── Required for mod_rewrite in subdirectories ──
# Without this, Apache returns 403 Forbidden on many configurations
Options +FollowSymLinks +SymLinksIfOwnerMatch

# ── Serve index.php when a directory is requested ──
DirectoryIndex index.php

# ── Prevent directory listing (security) ──
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── Set RewriteBase to the subdirectory ──
    # This tells Apache where the rewrite root is.
    # On XAMPP: /Redemption/
    # On live site root: /
    # If your app is in a different subdirectory, change this!
    RewriteBase /

    # ── Block direct access to sensitive directories ──
    RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|storage|tests|vendor|deploy|node_modules)(/|$) - [F,L,NC]

    # ── Block direct access to sensitive files ──
    RewriteRule ^(artisan|composer\.(json|lock)|package\.json|package-lock\.json|phpunit\.xml|vite\.config\.js|webpack\.mix\.js|\.env\.example|info\.php)(/|$) - [F,L,NC]

    # ── Handle Authorization Header ──
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ── Serve existing static files from public/ directory ──
    # Examples:
    #   /Redemption/css/app.css     → serves /Redemption/public/css/app.css
    #   /Redemption/favicon.ico     → serves /Redemption/public/favicon.ico
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # ── Route ALL other requests to root index.php ──
    # This handles all dynamic routes (login, dashboard, etc.)
    # as well as the root URL (/Redemption/).
    #
    # We only check "!-f" (not a file), NOT "!-d" (not a directory),
    # because /Redemption/ IS a directory and we want it to route
    # through index.php, not show a directory listing.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php [L]
</IfModule>

# ── Block direct access to .env file (CRITICAL SECURITY) ──
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# ── PHP Settings (only works with mod_php on Apache) ──
<IfModule mod_php.c>
    php_value session.gc_maxlifetime 28800
    php_value session.gc_probability 0
    php_value session.gc_divisor 1
    php_value session.cookie_lifetime 28800
</IfModule>
