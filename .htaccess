# ──────────────────────────────────────────────────────────────
# LARAVEL — REMOVE /public FROM URL (Root .htaccess)
# ──────────────────────────────────────────────────────────────
# Place this file in the PROJECT ROOT (same level as artisan, .env).
# On XAMPP, this is inside htdocs/Redemption/.
#
# This file routes ALL web traffic through root index.php so that
# /public is NOT needed in the URL. Static files (CSS, JS, images)
# are served from the public/ directory automatically.
#
# IMPORTANT: Do NOT set RewriteBase here! Apache auto-detects
# the base from the .htaccess directory.
# ──────────────────────────────────────────────────────────────

# ── Required for mod_rewrite in subdirectories ──
Options +FollowSymLinks +SymLinksIfOwnerMatch

# ── Serve index.php when a directory is requested ──
DirectoryIndex index.php

# ── Prevent directory listing (security) ──
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── DO NOT SET RewriteBase! ──
    # Apache auto-detects the base from the .htaccess directory.
    # Setting RewriteBase / would break everything by routing to
    # htdocs/index.php (XAMPP's redirect to /dashboard/).

    # ── Block direct access to sensitive directories ──
    RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|storage|tests|vendor|deploy|node_modules)(/|$) - [F,L,NC]

    # ── Block direct access to sensitive files ──
    RewriteRule ^(artisan|composer\.(json|lock)|package\.json|package-lock\.json|phpunit\.xml|vite\.config\.js|webpack\.mix\.js|\.env\.example|info\.php)(/|$) - [F,L,NC]

    # ── Handle Authorization Header ──
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ── Serve existing static files from public/ directory ──
    # When the browser requests /Redemption/css/admin.css, we need to
    # serve the file from /Redemption/public/css/admin.css.
    #
    # HOW IT WORKS:
    #   %{REQUEST_FILENAME} = the physical path Apache resolves for the URL
    #     e.g., C:/xampp/htdocs/Redemption/css/admin.css
    #   We check if C:/xampp/htdocs/Redemption/public/css/admin.css exists
    #   If yes, rewrite to public/$1 so Apache serves it.
    #
    # We do NOT use %{DOCUMENT_ROOT}/public%{REQUEST_URI} because
    # REQUEST_URI includes the subdirectory (/redemption/css/admin.css)
    # and DOCUMENT_ROOT doesn't, so the path would be wrong.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # ── Route ALL other requests to root index.php ──
    # This catches everything that isn't a real static file.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php [L]
</IfModule>

# ── Block direct access to .env file (CRITICAL SECURITY) ──
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# ── PHP Settings (only works with mod_php on Apache) ──
<IfModule mod_php.c>
    php_value session.gc_maxlifetime 28800
    php_value session.gc_probability 0
    php_value session.gc_divisor 1
    php_value session.cookie_lifetime 28800
</IfModule>
