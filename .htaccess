<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── For XAMPP / shared hosting where document root is the project root ──
    # Route all requests to Laravel's public directory.

    # If request already points to public/, stop rewriting
    RewriteCond %{THE_REQUEST} /public/ [NC]
    RewriteRule ^ - [L]

    # Don't rewrite if the request maps to an existing file/dir in public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Rewrite everything else to public/index.php (Laravel front controller)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Disable directory listing
Options -Indexes

# Block access to sensitive files from the web
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
