# ──────────────────────────────────────────────────────────────
# LARAVEL — REMOVE /public FROM URL (Root .htaccess)
# ──────────────────────────────────────────────────────────────
# Place this file in the PROJECT ROOT (same level as artisan, .env).
# On shared hosting, this is inside public_html/ or htdocs/.
#
# This file does TWO things:
# 1. Routes all web traffic to public/index.php (so /public is NOT in the URL)
# 2. Blocks direct access to sensitive Laravel files and directories
#
# KEY: We route to public/index.php (NOT root index.php) because
# Laravel's public/index.php + Symfony's Request class properly
# detect and handle subdirectories like /Redemption on XAMPP.
# ──────────────────────────────────────────────────────────────

DirectoryIndex public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── Block direct access to sensitive directories ──
    # Returns 403 Forbidden if someone tries to access app/, config/, etc. directly
    RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|storage|tests|vendor|deploy|node_modules)(/|$) - [F,L,NC]

    # ── Block direct access to sensitive files ──
    RewriteRule ^(artisan|composer\.(json|lock)|package\.json|package-lock\.json|phpunit\.xml|vite\.config\.js|webpack\.mix\.js|\.env\.example)(/|$) - [F,L,NC]

    # ── Handle Authorization Header ──
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ── If request is for an existing file in public/, serve it directly ──
    # CSS, JS, images, fonts, APK, etc.
    RewriteCond %{DOCUMENT_ROOT}/public/%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # ── If request is for an existing directory in public/, serve it ──
    RewriteCond %{DOCUMENT_ROOT}/public/%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # ── Route ALL other requests to public/index.php ──
    # This is the key: we use Laravel's standard public/index.php as
    # the front controller. Symfony's Request class automatically detects
    # the subdirectory from SCRIPT_NAME and generates correct URLs.
    # e.g. SCRIPT_NAME=/Redemption/public/index.php → base path=/Redemption
    #      route('login') → http://localhost/Redemption/login ✓
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>

# ── Block direct access to .env file (CRITICAL SECURITY) ──
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# ── PHP Settings (only works with mod_php on Apache) ──
# For PHP-CGI/FPM, use .user.ini instead
<IfModule mod_php.c>
    php_value session.gc_maxlifetime 28800
    php_value session.gc_probability 0
    php_value session.gc_divisor 1
    php_value session.cookie_lifetime 28800
</IfModule>
