# ──────────────────────────────────────────────────────────────
# LARAVEL — REMOVE /public FROM URL (Root .htaccess)
# ──────────────────────────────────────────────────────────────
# Place this file in the PROJECT ROOT (same level as artisan, .env).
# On XAMPP, this is inside htdocs/redemption/.
# On cPanel, this is inside public_html/ or a subdirectory.
#
# Strategy: Route all requests through root index.php.
# Laravel's catch-all route in routes/web.php serves static
# files from public/ via public_path(). Dynamic routes are
# handled by Laravel's router normally.
# ──────────────────────────────────────────────────────────────

DirectoryIndex index.php
Options -Indexes
Options +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── Allow /storage/ URLs (serves uploaded images, logos, files) ──
    # /storage/X rewrites to /public/storage/X
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    # ── Block direct access to sensitive directories ──
    # Note: 'storage' EXCLUDED — /storage/ URL serves public uploads.
    # Note: 'lang' EXCLUDED — /lang/{locale} route for language switching.
    # Note: 'public' EXCLUDED — needed for direct /public access fallback.
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor|deploy|node_modules)(/|$) - [F,L,NC]

    # ── Block direct access to sensitive files ──
    RewriteRule ^(artisan|composer\.(json|lock)|package\.json|package-lock\.json|phpunit\.xml|vite\.config\.js|webpack\.mix\.js|\.env\.example)(/|$) - [F,L,NC]

    # ── Handle Authorization Header ──
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ── Serve existing files/directories directly ──
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ── Route everything else to root index.php ──
    # Root index.php fixes SCRIPT_NAME for subdirectory hosting,
    # then includes public/index.php to bootstrap Laravel.
    # Laravel's catch-all route serves static files from public/
    # via public_path(), and handles all dynamic routes normally.
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_value session.gc_maxlifetime 28800
    php_value session.gc_probability 0
    php_value session.gc_divisor 1
    php_value session.cookie_lifetime 28800
</IfModule>
