# ──────────────────────────────────────────────────────────────
# LARAVEL — REMOVE /public FROM URL (Root .htaccess)
# ──────────────────────────────────────────────────────────────
# Place this file in the DOCUMENT ROOT (public_html or htdocs)
# when the entire Laravel project is uploaded there.
# It routes all requests so URLs don't show /public.
# ──────────────────────────────────────────────────────────────

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Set RewriteBase to root — needed on some shared hosts
    RewriteBase /

    # ── Allow /storage/ URLs (serves uploaded images, logos, files) ──
    # /storage/X maps to /public/storage/X physically, and falls through
    # to Laravel's MediaController route if the file doesn't exist.
    # Do NOT block /storage/ here — it breaks ALL uploaded images.

    # ── Block direct access to sensitive directories ──
    # Note: 'storage' is intentionally EXCLUDED from this list.
    # The /storage/ URL path serves public uploads (logos, photos, etc.)
    # and is NOT the same as the on-disk storage/ directory.
    RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|tests|vendor|deploy|node_modules)(/|$) - [F,L,NC]

    # ── Block direct access to sensitive files ──
    RewriteRule ^(artisan|composer\.(json|lock)|package\.json|package-lock\.json|phpunit\.xml|vite\.config\.js|webpack\.mix\.js|\.env\.example)(/|$) - [F,L,NC]

    # ── Handle Authorization Header ──
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ── Serve existing files from public/ directly ──
    # CSS, JS, images, fonts, APK files, etc.
    RewriteCond %{DOCUMENT_ROOT}/public/%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # ── Serve existing directories from public/ ──
    RewriteCond %{DOCUMENT_ROOT}/public/%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # ── Route all other requests through root index.php ──
    # This uses the ROOT index.php (which bootstraps Laravel directly)
    # as the front controller, bypassing the need for /public in the URL.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [L]
</IfModule>

# ── Block direct access to .env file (CRITICAL SECURITY) ──
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# ── PHP Settings (only works with mod_php on Apache) ──
# For PHP-CGI/FPM, use .user.ini instead
<IfModule mod_php.c>
    php_value session.gc_maxlifetime 28800
    php_value session.gc_probability 0
    php_value session.gc_divisor 1
    php_value session.cookie_lifetime 28800
</IfModule>
