# ================================================================
# PRODUCTION ENVIRONMENT TEMPLATE
# ================================================================
# Copy this file to .env on your shared hosting server
# and fill in the values for your hosting account.
# ================================================================

APP_NAME="School of Redemption"
APP_ENV=production
APP_KEY=base64:ohQPbRXUl3jwBUGOB6/hE+MKYNHN5Law3vSxiwDwbGM=
APP_DEBUG=false
# IMPORTANT: Change this to your actual hosting URL (NO /public)!
# GoogieHost example: APP_URL=http://yoursite.googiehost.com
# InfinityFree example: APP_URL=http://yoursite.epizy.com
# Custom domain: APP_URL=https://yoursite.com
APP_URL=http://YOUR_SITE.googiehost.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ================================================================
# DATABASE - Get these from your hosting control panel (MySQL)
# ================================================================
# GoogieHost/cPanel: DB_HOST is usually "localhost"
# InfinityFree/ByetHost: DB_HOST is like "sqlXXX.byethost.com"
DB_CONNECTION=mysql
DB_HOST=localhost                     # GoogieHost = localhost | ByetHost = sqlXXX.byethost.com
DB_PORT=3306
DB_DATABASE=your_cpanel_user_school_of_redemption  # Full name with cPanel prefix
DB_USERNAME=your_cpanel_user_admin                  # Full username with cPanel prefix
DB_PASSWORD=your_db_password                        # The password you set

# ================================================================
# SESSION - Use database driver for shared hosting
# ================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ================================================================
# MAIL - Configure if you need email functionality
# ================================================================
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@yoursite.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
