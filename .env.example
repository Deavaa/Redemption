APP_NAME="School of Redemption"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# IMPORTANT: Set this to your FULL URL including any subdirectory!
# XAMPP example:  APP_URL=https://localhost/Redemption/public
# Virtual host:   APP_URL=http://yoursite.com
APP_URL=https://localhost/Redemption/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Supported locales: en (English), am (Amharic / አማርኛ)

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_of_redemption
DB_USERNAME=root
DB_PASSWORD=

# ── SESSION SETTINGS ──
# These values ARE respected by AppServiceProvider and config/session.php.
# Change them as needed for your environment.
#
# SESSION_DRIVER: 'file' (recommended for XAMPP — fast, no DB needed)
#                 'database' (slower on XAMPP — sessions table may have issues)
# SESSION_LIFETIME: minutes until session expires. 525600 = 1 year (indefinite)
SESSION_DRIVER=file
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/Redemption/public
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS="noreply@schoolofredemption.com"
MAIL_FROM_NAME="${APP_NAME}"

# NOTE: To send database exports via email, you MUST configure a real SMTP server above.
# For Gmail: Use an App Password (not your regular password) from https://myaccount.google.com/apppasswords
# If MAIL_MAILER=log, emails will only be written to storage/logs/laravel.log and NOT actually sent.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SMS Configuration
# Supported drivers: africas_talking, twilio, custom, log
# log = SMS messages are written to storage/logs/laravel.log (for development)
SMS_DRIVER=log
SMS_API_KEY=
SMS_API_URL=
SMS_USERNAME=
SMS_SENDER_ID=Redemption
SMS_RECIPIENTS=
# For Africa's Talking: SMS_DRIVER=africas_talking, SMS_USERNAME=your_username, SMS_API_KEY=your_api_key
# For Twilio: SMS_DRIVER=twilio, TWILIO_SID=your_sid, TWILIO_AUTH_TOKEN=your_token, TWILIO_PHONE_NUMBER=+1234567890
